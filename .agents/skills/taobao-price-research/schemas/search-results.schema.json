{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan",
    "coverage",
    "candidates"
  ],
  "properties": {
    "plan": {
      "type": "object"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queries_executed",
        "source_backend",
        "pages_read",
        "cards_seen",
        "blocked_reasons"
      ],
      "properties": {
        "queries_executed": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          }
        },
        "source_backend": {
          "const": "aialra-shopping-browser"
        },
        "pages_read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "cards_seen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "blocked_reasons": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "source_backend",
          "query",
          "page_number",
          "title",
          "displayed_price_min",
          "displayed_price_max",
          "seller_name",
          "sales_text",
          "image_url",
          "url",
          "retrieved_at"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "source_backend": {
            "const": "aialra-shopping-browser"
          },
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "page_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500
          },
          "displayed_price_min": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "displayed_price_max": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "seller_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "sales_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "image_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "url": {
            "type": "string",
            "minLength": 12,
            "maxLength": 3000
          },
          "retrieved_at": {
            "type": "string",
            "minLength": 20,
            "maxLength": 64
          }
        }
      }
    }
  }
}
