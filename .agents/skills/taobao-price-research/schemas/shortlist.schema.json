{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan",
    "coverage",
    "filter_summary",
    "shortlist"
  ],
  "properties": {
    "plan": {
      "type": "object"
    },
    "coverage": {
      "type": "object"
    },
    "filter_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_candidates",
        "duplicates_removed",
        "obvious_mismatches_removed",
        "selected_for_detail"
      ],
      "properties": {
        "input_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 80
        },
        "duplicates_removed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 80
        },
        "obvious_mismatches_removed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 80
        },
        "selected_for_detail": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "shortlist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "title",
          "displayed_price_min",
          "displayed_price_max",
          "seller_name",
          "sales_text",
          "image_url",
          "url",
          "matched_queries",
          "retrieved_at"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500
          },
          "displayed_price_min": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "displayed_price_max": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "seller_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "sales_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "image_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "url": {
            "type": "string",
            "minLength": 12,
            "maxLength": 3000
          },
          "matched_queries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200
            }
          },
          "retrieved_at": {
            "type": "string",
            "minLength": 20,
            "maxLength": 64
          }
        }
      }
    }
  }
}
